# Keep the build context small AND keep secrets/local junk off the Docker daemon.
# The image only COPYs pyproject.toml + agent/, but the whole context is sent to
# the daemon unless excluded here.
.git
.github
external-agents/
regression/
scratch/
tmp/
docs/secret.env
*.env
!.env.example
*.secret
secrets/
**/__pycache__/
**/*.pyc
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
result.json
.result-*.tmp
chal-*/
Dockerfile*
.dockerignore
