# Keep the submission image lean and secret-free. Only agent/ + pyproject are
# needed at build time (see Dockerfile).
.git/
.github/
.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc
*.log
.env
.env.*

# not needed in the image
tests/
docs/
tools/
scratch/
tmp/

# external agent source — research only, never ship or upload
external-agents/
