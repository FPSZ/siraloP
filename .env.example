# Local dev only. In the submission image the platform injects these at runtime
# (CTFY-0001 §1.1); never commit a filled-in copy — .env is gitignored.
# Copy to .env and fill in:  cp .env.example .env

# --- platform (CTFY-0001 §1.2) ---
CTFY_PLATFORM_URL=https://ctfy.tsinghua.edu.cn
CTFY_TOKEN=pf_xxx_your_scoped_token
# Evaluation context the platform sets per run (optional locally):
CTFY_EVAL_COMPETITION_ID=
CTFY_EVAL_CHALLENGE_ID=
CTFY_WORK_DIR=/ctfy/work
CTFY_EVAL_MAX_TURNS=
CTFY_EVAL_MAX_TOKENS=
# Set to 1 to prove the image boots + writes result.json without any model calls:
CTFY_EVAL_DRY_RUN=0

# --- model gateway (CTFY-0001 §1.1) ---
# flavor selects the wire format: "anthropic" (/v1/messages) or "openai"
# (/v1/chat/completions, the default for any other value).
LLM_FLAVOR=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
